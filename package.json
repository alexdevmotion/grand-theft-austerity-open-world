{
  "name": "grand-theft-austerity-open-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Third-person open-world Bucharest \u2014 B\u2605 BUILDERSTAR GAMES",
  "scripts": {
    "dev": "vite --port 5273 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5274 --strictPort",
    "shot": "node tools/shot.mjs",
    "test": "bun test",
    "audio:sync": "node tools/sync-audio.mjs",
    "assets:cast": "bun tools/blender/export-cast.ts && blender --background --threads 2 --python tools/blender/build-cast.py && blender --background --threads 2 --python tools/blender/fit-anatomical-cast.py",
    "assets:vehicles": "bun tools/blender/export-vehicles.ts && blender --background --threads 2 --python tools/blender/build-vehicles.py",
    "assets:buildings": "bun tools/blender/export-buildings.ts && blender --background --threads 2 --python tools/blender/build-buildings.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "n8ao": "2.0.0",
    "postprocessing": "6.39.4",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.13"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.0",
    "@types/node": "24",
    "@types/three": "0.185.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-glsl": "1.5.1"
  }
}
